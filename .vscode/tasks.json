{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "create-build-folder",
            "type": "shell",
            "command": "New-Item",
            "args": [
                "-ItemType",
                "Directory",
                "-Force",
                "-Path",
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "compile",
            "type": "shell",
            "command": "cl",
            "args": [
                "/EHsc",
                "/std:c++17",
                "/Zi",
                "/nologo",
                "/DUNICODE",
                "/D_UNICODE",
                "/I${workspaceFolder}\\include",
                "/Fo${workspaceFolder}\\build\\",
                "/Fd${workspaceFolder}\\build\\",
                "/Fe${workspaceFolder}\\build\\laptop_keyboard_disabler.exe",
                "${workspaceFolder}\\src\\*.cpp",
                "/link",
                "/SUBSYSTEM:WINDOWS",
                "/MANIFEST:NO",
                "user32.lib",
                "shell32.lib",
                "setupapi.lib",
                "ole32.lib",
                "uuid.lib"
            ],
            "dependsOn": "create-build-folder",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build",
            "type": "shell",
            "command": "mt",
            "args": [
                "-nologo",
                "-manifest",
                "${workspaceFolder}\\app.manifest",
                {
                    "value": "-outputresource:${workspaceFolder}\\build\\laptop_keyboard_disabler.exe;1",
                    "quoting": "strong"
                }
            ],
            "dependsOn": "compile",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ]
}